{
  "name": "bolexcollector",
  "version": "1.0.0",
  "private": true,
  "description": "Digital preservation archive and modern museum edition of BolexCollector.com — the definitive reference for Paillard-Bolex cameras, lenses, and accessories.",
  "scripts": {
    "dev": "next dev",
    "predev": "npm run stage:archive",
    "prebuild": "npm run build:serials && npm run stage:archive && npm run search:index",
    "build": "next build",
    "build:serials": "tsx scripts/build-serials.ts",
    "stage:archive": "tsx scripts/stage-archive.ts",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "pipeline": "tsx scripts/run-all.ts",
    "pipeline:discover": "tsx scripts/discover.ts",
    "pipeline:download": "tsx scripts/download.ts",
    "pipeline:extract": "tsx scripts/extract.ts",
    "pipeline:verify": "tsx scripts/verify.ts",
    "pipeline:report": "tsx scripts/report.ts",
    "search:index": "tsx scripts/build-search-index.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.2.5",
    "@fontsource-variable/fraunces": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "fuse.js": "^7.1.0",
    "gray-matter": "^4.0.3",
    "marked": "^15.0.7",
    "motion": "^12.7.0",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.4",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/turndown": "^5.0.5",
    "node-html-parser": "^7.0.1",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.19.3",
    "turndown": "^7.2.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
